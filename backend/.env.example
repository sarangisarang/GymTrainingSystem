# Backend environment variables
# Copy this file to .env and fill in your values

# JWT — change this to a random secret in production (min. 32 chars)
JWT_SECRET_KEY=change_me_in_production

# AI Coach (Google Gemini)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# App timezone — used for week boundary in analytics
# Examples: Europe/Berlin, Europe/Tbilisi, UTC
APP_TIMEZONE=Europe/Berlin

# Optional: PostgreSQL (defaults to SQLite if not set)
# POSTGRES_URL=postgresql://user:password@localhost:5432/gymdb
