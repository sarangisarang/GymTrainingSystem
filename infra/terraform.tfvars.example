# Example variable overrides for the Phase 1 foundation.
#
# All variables already have sensible defaults in variables.tf, so this file
# is OPTIONAL — copy it to terraform.tfvars only if you want to override them.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored (it may hold per-user / sensitive values);
# this .example file is the committed template.

# project_name = "gymtracker"
# aws_region   = "eu-central-1"

# vpc_cidr = "10.0.0.0/16"
# az_count = 2

# public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24"]
# private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
