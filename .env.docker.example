# Copy this file to `.env` (same directory as docker-compose.yml) and fill in
# your values. docker compose reads it automatically. Never commit the real .env.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
POSTGRES_DB=gym

# ── Backend ──────────────────────────────────────────────────────────────────
# Use a long random string in production (min. 32 chars).
JWT_SECRET_KEY=change_me_in_production

# AI Coach (Google Gemini). Leave empty to run without it — /ai/coach then
# returns HTTP 503 and the rest of the app works normally.
GEMINI_API_KEY=

# Timezone used for analytics week boundaries (e.g. Europe/Berlin, Asia/Tbilisi).
APP_TIMEZONE=Europe/Berlin

# ── Frontend ─────────────────────────────────────────────────────────────────
# Host-reachable backend URL the browser will call (baked in at build time).
NEXT_PUBLIC_API_BASE=http://localhost:8000
